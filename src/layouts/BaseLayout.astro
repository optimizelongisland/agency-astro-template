---
import SEO from '../components/SEO.astro';
import SiteSchema from '../components/schema/SiteSchema.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ratingValue?: number;
  reviewCount?: number;
  noindex?: boolean; // keep utility pages (thank-you, etc.) out of search results
}

const { title, description, ogImage, ratingValue, reviewCount, noindex } = Astro.props;

// ---- CLIENT INFO: edit these once per client build ----
const business = {
  businessName: 'Client Business Name',
  phone: '(555) 555-5555',
  streetAddress: '123 Main St',
  city: 'City',
  region: 'NY',
  postalCode: '00000',
  areaServed: ['Town One', 'Town Two', 'Town Three'],
  // Full URLs for every real profile this business has. Feeds LocalBusiness
  // schema's sameAs field, consolidating this site and these profiles as one entity.
  socialProfiles: [
    // 'https://www.facebook.com/clientbusiness',
    // 'https://www.instagram.com/clientbusiness',
    // 'https://www.google.com/maps/place/...',
    // 'https://www.yelp.com/biz/clientbusiness',
  ],
};

// ---- TRACKING: set these in .env per client, not hardcoded here ----
// PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXX
// PUBLIC_GSC_VERIFICATION=your-verification-token
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      ratingValue={ratingValue}
      reviewCount={reviewCount}
      noindex={noindex}
      {...business}
    />
    <SiteSchema businessName={business.businessName} socialProfiles={business.socialProfiles} />

    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}

    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header businessName={business.businessName} phone={business.phone} />
    <main id="main-content">
      <slot />
    </main>
    <Footer businessName={business.businessName} phone={business.phone} areaServed={business.areaServed} />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--deep);
    color: var(--paper);
    padding: 12px 20px;
    z-index: 100;
    font-weight: 600;
    font-size: 14px;
  }
  .skip-link:focus {
    left: 16px;
    top: 16px;
  }
</style>
