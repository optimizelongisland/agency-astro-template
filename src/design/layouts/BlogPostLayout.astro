---
// DESIGN LAYER - restyle or replace freely.
import SiteLayout from './SiteLayout.astro';
import BlogPostSchema from '../../core/components/schema/BlogPostSchema.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { business } from '../../site';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, metaDescription, publishDate, updatedDate, author, coverImage, coverImageAlt, tags } =
  post.data;

const formattedDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<SiteLayout title={`${title} | ${business.businessName}`} description={metaDescription} ogImage={coverImage.src}>
  <article class="post">
    <div class="wrap post-header">
      <p class="post-meta">
        {formattedDate} · {author}
      </p>
      <h1>{title}</h1>
      {
        tags.length > 0 && (
          <div class="tags">
            {tags.map((tag: string) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )
      }
    </div>

    <div class="cover-wrap">
      <Image src={coverImage} alt={coverImageAlt} width={1120} height={560} loading="eager" />
    </div>

    <div class="wrap post-body">
      <slot />
    </div>
  </article>

  <BlogPostSchema
    title={title}
    description={metaDescription}
    publishDate={publishDate}
    updatedDate={updatedDate}
    author={author}
  />
</SiteLayout>

<style>
  .post-header {
    padding-top: 56px;
    padding-bottom: 32px;
    max-width: 720px;
  }
  .post-meta {
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 12px;
  }
  .post-header h1 {
    font-size: clamp(30px, 4.5vw, 46px);
    line-height: 1.1;
  }
  .tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 20px;
  }
  .tag {
    font-size: 13px;
    padding: 4px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--accent-2);
  }
  .cover-wrap {
    max-width: var(--max-width);
    margin: 0 auto 48px;
    padding: 0 24px;
  }
  .cover-wrap :global(img) {
    border-radius: var(--radius);
    width: 100%;
    height: auto;
  }
  .post-body {
    max-width: 720px;
    padding-bottom: 88px;
    font-size: 17px;
  }
  .post-body :global(h2) {
    font-size: 26px;
    margin: 40px 0 16px;
  }
  .post-body :global(h3) {
    font-size: 20px;
    margin: 32px 0 12px;
  }
  .post-body :global(p) {
    margin-bottom: 18px;
    color: #2b3530;
  }
  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0 0 18px 22px;
  }
  .post-body :global(a) {
    color: var(--accent-2);
    text-decoration: underline;
  }
</style>
