---
// DESIGN LAYER - restyle or replace freely.
// Visible FAQ list. The matching structured data comes from the locked core
// component FaqSchema, fed the same items, so the two always agree.
import FaqSchema, { type FaqItem } from '../../core/components/schema/FaqSchema.astro';

interface Props {
  heading?: string;
  items: FaqItem[];
}
const { heading = 'Frequently asked questions', items } = Astro.props;
---

<section class="faq section" id="faq">
  <div class="wrap">
    <h2>{heading}</h2>
    <div class="faq-list">
      {
        items.map((item) => (
          <details class="faq-item" name="faq">
            <summary>
              <span>{item.question}</span>
              <span class="chevron" aria-hidden="true">+</span>
            </summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<FaqSchema items={items} />

<style>
  .faq h2 {
    font-size: clamp(28px, 3.4vw, 38px);
    margin-bottom: 32px;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
    max-width: 760px;
  }
  .faq-item {
    border-bottom: 1px solid var(--line);
    padding: 20px 0;
  }
  .faq-item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    cursor: pointer;
    font-weight: 600;
    font-size: 16px;
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .chevron {
    font-family: var(--font-display);
    font-size: 22px;
    color: var(--accent-2);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }
  .faq-item[open] .chevron {
    transform: rotate(45deg);
  }
  .faq-item p {
    margin-top: 12px;
    color: var(--muted);
    font-size: 15px;
    max-width: 65ch;
  }
</style>
