---
interface Props {
  eyebrow: string;
  headline: string;
  subhead: string;
  phone: string;
  trustPoints: string[]; // e.g. ["15+ years on Long Island", "Licensed & insured"]
}
const { eyebrow, headline, subhead, phone, trustPoints } = Astro.props;
const telHref = `tel:${phone.replace(/[^\d]/g, '')}`;
---

<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{headline}</h1>
      <p class="lede">{subhead}</p>
      <div class="hero-actions">
        <a href="#contact" class="btn btn-solid">Request a Free Estimate</a>
        <a href={telHref} class="btn btn-line">Call {phone}</a>
      </div>
      <div class="trust-row">
        {trustPoints.map((point) => <span>{point}</span>)}
      </div>
    </div>
    <div class="hero-visual">
      <slot name="visual">
        <!-- Drop a Higgsfield-generated image/animation here per client,
             or an <img> using astro:assets Image component -->
      </slot>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 88px 0 64px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: center;
  }
  .eyebrow {
    font-size: 14px;
    color: var(--accent-2);
    font-weight: 600;
    margin-bottom: 18px;
  }
  h1 {
    font-size: clamp(38px, 5vw, 58px);
    line-height: 1.05;
    margin-bottom: 22px;
  }
  .lede {
    font-size: 18px;
    color: #3d4a44;
    max-width: 44ch;
    margin-bottom: 32px;
  }
  .hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .trust-row {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
    font-size: 14px;
    color: #4b5750;
  }
  .hero-visual {
    width: 100%;
    aspect-ratio: 1 / 1;
  }
  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-visual {
      order: -1;
      max-width: 360px;
      margin: 0 auto;
    }
  }
</style>
