---
interface Props {
  heading: string;
  subheading: string;
  phone: string;
  email: string;
}
const { heading, subheading, phone, email } = Astro.props;
const telHref = `tel:${phone.replace(/[^\d]/g, '')}`;
---

<section class="cta-band" id="contact">
  <div class="wrap">
    <h2>{heading}</h2>
    <p>{subheading}</p>
    <div class="cta-actions">
      <a href={telHref} class="btn btn-solid">Call {phone}</a>
      <a href={`mailto:${email}`} class="btn btn-line">Email Us</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding: 80px 0;
    text-align: center;
  }
  .cta-band h2 {
    font-size: clamp(28px, 4vw, 40px);
    margin-bottom: 16px;
  }
  .cta-band p {
    color: #4b5750;
    margin-bottom: 32px;
    font-size: 16px;
  }
  .cta-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
