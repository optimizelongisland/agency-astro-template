---
// Wraps astro:assets Image with sane defaults so every client photo
// gets responsive sizes + WebP/AVIF automatically, without repeating
// the same widths/sizes config on every page.
//
// Usage:
//   import Photo from '../components/Photo.astro';
//   import truckPhoto from '../assets/truck.jpg'; // local file under src/assets
//   <Photo src={truckPhoto} alt="Service van parked in a driveway" />
//
// IMPORTANT: `src` must be a local import from src/assets/, not a string path.
// Astro can only optimize images it processes at build time.

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string; // required on purpose - write real, descriptive alt text
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  src,
  alt,
  widths = [400, 800, 1200],
  sizes = '(max-width: 820px) 100vw, 50vw',
  loading = 'lazy',
  class: className,
} = Astro.props;
---

<Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} class={className} />
