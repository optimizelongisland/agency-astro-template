---
// CORE - do not edit per client. See src/core/README.md.
//
// Site-wide schema, rendered once in CoreLayout (not per-page like LocalBusiness
// in SEO.astro). Organization/WebSite reinforce brand-level identity separate
// from the location-specific LocalBusiness schema - both can coexist safely.
interface Props {
  businessName: string;
  logoPath?: string; // path under /public, e.g. "/logo.png". Omitted from the schema when empty.
  socialProfiles?: string[];
}
const { businessName, logoPath = '', socialProfiles = [] } = Astro.props;

const siteURL = Astro.site?.toString() ?? '/';
const logoURL = logoPath ? new URL(logoPath, Astro.site).toString() : undefined;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: businessName,
  url: siteURL,
  ...(logoURL && { logo: logoURL }),
  ...(socialProfiles.length > 0 && { sameAs: socialProfiles }),
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: businessName,
  url: siteURL,
};
---

<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
