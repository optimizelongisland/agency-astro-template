---
// CORE - do not edit per client. See src/core/README.md.
//
// Reusable SEO head block. Business details come from src/site.ts via CoreLayout;
// title and description are set per page.
interface Props {
  title: string;
  description: string;
  businessName: string;
  phone: string;
  streetAddress: string; // leave empty for a service-area business with no public address
  city: string;
  region: string; // e.g. "NY"
  postalCode: string;
  areaServed: string[]; // e.g. ["Huntington", "Babylon", "Smithtown"]
  ogImage?: string; // path relative to /public, e.g. "/og-image.jpg". Defaults below if omitted.
  socialProfiles?: string[]; // full URLs: Facebook, Instagram, GBP, Yelp, LinkedIn, etc.
  ratingValue?: number; // e.g. 4.9. Only set once real reviews exist - never fabricate this.
  reviewCount?: number; // real count matching ratingValue above
  noindex?: boolean; // true on utility pages that should stay out of search results
}

const {
  title,
  description,
  businessName,
  phone,
  streetAddress,
  city,
  region,
  postalCode,
  areaServed,
  ogImage = '/og-image.jpg',
  socialProfiles = [],
  ratingValue,
  reviewCount,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: businessName,
  telephone: phone,
  address: {
    "@type": "PostalAddress",
    // Empty parts are left out rather than published as blank values.
    ...(streetAddress && { streetAddress }),
    ...(city && { addressLocality: city }),
    ...(region && { addressRegion: region }),
    ...(postalCode && { postalCode }),
  },
  areaServed: areaServed.map((a) => ({ "@type": "City", name: a })),
  url: canonicalURL.toString(),
  // Confirms to Google/AI engines this site and these profiles are the same
  // business entity - meaningfully helps local trust and citation consolidation.
  ...(socialProfiles.length > 0 && { sameAs: socialProfiles }),
  // Only include when both values are real. A rating with no review count (or
  // vice versa) is invalid per Google's guidelines and can trigger a manual
  // action - never fabricate or estimate these numbers.
  ...(ratingValue != null &&
    reviewCount != null && {
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue,
        reviewCount,
      },
    }),
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, follow" />}

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:site_name" content={businessName} />

<!-- Twitter card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

<!-- Structured data for local search -->
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
