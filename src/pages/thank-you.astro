---
// Shown after a successful contact form submission. Having a real page (rather
// than an inline message) gives GA4 and Google Ads a clean URL to count as a
// conversion. It is kept out of search results and the sitemap.
import SiteLayout from '../design/layouts/SiteLayout.astro';
---

<SiteLayout
  title="Thank You | Message Received"
  description="Thanks for getting in touch. We'll be in contact shortly."
  noindex
>
  <section class="section wrap thank-you">
    <h1>Thanks, we got your message.</h1>
    <p>We'll get back to you within one business day.</p>
    <a href="/" class="btn btn-solid">Back to homepage</a>
  </section>
</SiteLayout>

<style>
  .thank-you {
    text-align: center;
    padding: 140px 24px;
  }
  .thank-you h1 {
    font-size: clamp(32px, 5vw, 48px);
    margin-bottom: 16px;
  }
  .thank-you p {
    color: var(--muted);
    margin-bottom: 32px;
  }
</style>
