---
// CORE - do not edit per client. See src/core/README.md.
//
// The technical page shell: document head, SEO tags, structured data,
// analytics, and the skip link. It has no visual design of its own. The
// design layer (src/design/layouts/SiteLayout.astro) wraps this and supplies
// everything a visitor sees.
//
// Slots:
//   head     - extra <head> tags from the design layer (fonts, preloads)
//   default  - the page body. Must contain <main id="main-content">.
import SEO from '../components/SEO.astro';
import SiteSchema from '../components/schema/SiteSchema.astro';
import { business } from '../../site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ratingValue?: number; // only with real reviews - never estimate
  reviewCount?: number;
  noindex?: boolean; // keep utility pages out of search results
}
const { title, description, ogImage, ratingValue, reviewCount, noindex } = Astro.props;

// Set in .env / the host's environment, not here.
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      ratingValue={ratingValue}
      reviewCount={reviewCount}
      noindex={noindex}
      businessName={business.businessName}
      phone={business.phone}
      streetAddress={business.streetAddress}
      city={business.city}
      region={business.region}
      postalCode={business.postalCode}
      areaServed={business.areaServed}
      socialProfiles={business.socialProfiles}
    />
    <SiteSchema
      businessName={business.businessName}
      logoPath={business.logoPath}
      socialProfiles={business.socialProfiles}
    />

    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}

    {
      gaId && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || []; function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date()); gtag('config', gaId);
          </script>
        </>
      )
    }

    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <slot />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--deep, #111);
    color: var(--on-deep, #fff);
    padding: 12px 20px;
    z-index: 1000;
    font-weight: 600;
    font-size: 14px;
  }
  .skip-link:focus {
    left: 16px;
    top: 16px;
  }
</style>
