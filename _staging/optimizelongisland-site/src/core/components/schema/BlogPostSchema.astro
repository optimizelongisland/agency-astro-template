---
// CORE - do not edit per client. See src/core/README.md.
//
// BlogPosting structured data for a single blog post.
import { business } from '../../../site';

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  updatedDate?: Date;
  // The business name (the default) is published as an Organization author.
  // A person's name is published as a Person, so only use one for a real
  // person who wrote or reviewed the post and has agreed to be named.
  author: string;
  authorUrl?: string; // that person's bio page on this site
}
const { title, description, publishDate, updatedDate, author, authorUrl } = Astro.props;

const authorIsBusiness = author.trim().toLowerCase() === business.businessName.trim().toLowerCase();
const authorNode = authorIsBusiness
  ? { '@type': 'Organization', name: business.businessName }
  : {
      '@type': 'Person',
      name: author,
      ...(authorUrl && { url: new URL(authorUrl, Astro.site).toString() }),
    };

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: publishDate.toISOString(),
  dateModified: (updatedDate ?? publishDate).toISOString(),
  author: authorNode,
  publisher: { '@type': 'Organization', name: business.businessName },
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
