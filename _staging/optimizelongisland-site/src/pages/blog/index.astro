---
import SiteLayout from '../../design/layouts/SiteLayout.astro';
import PageHead from '../../design/components/PageHead.astro';
import ContactSection from '../../design/components/ContactSection.astro';
import { business } from '../../site';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<SiteLayout
  title={`Blog: Websites, SEO and AI Search | ${business.businessName}`}
  description="Plain answers for Long Island business owners on website costs, local SEO, Google Ads and getting named in AI answers, from Optimize Long Island."
>
  <PageHead crumbs={[{ name: 'Blog', url: '/blog/' }]} eyebrow="Blog" title="Notes on websites, local search and AI answers." lede="Plain answers for Long Island business owners about website costs, local SEO, Google Ads and getting named in AI answers." cta={false} />

  <section class="section">
    <div class="wrap">
      {
        posts.length > 0 ? (
          <ul class="posts">
            {posts.map((post) => (
              <li>
                <a href={`/blog/${post.id}/`}>
                  <span class="date mono">{fmt(post.data.publishDate)}</span>
                  <h2>{post.data.title}</h2>
                  <p class="desc">{post.data.metaDescription}</p>
                  <span class="read">Read →</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p>No posts yet. <a class="link" href="/services/">See our services.</a></p>
        )
      }
    </div>
  </section>
  <ContactSection />
</SiteLayout>

<style>
  .posts { list-style: none; border-bottom: 1px solid var(--line); }
  li { border-top: 1px solid var(--line); }
  a { display: block; padding: 40px 0; max-width: 860px; }
  .date { display: block; font-size: 13px; color: var(--muted); margin-bottom: 12px; }
  h2 { font-size: clamp(22px, 3vw, 26px); line-height: 1.25; letter-spacing: -0.01em; margin-bottom: 12px; }
  .desc { color: var(--muted); font-size: 16px; margin-bottom: 14px; }
  .read { color: var(--accent-2); font-weight: 500; }
  a:hover h2 { color: var(--accent-2); }
  @media (max-width: 640px) { a { padding: 28px 0; } }
</style>
