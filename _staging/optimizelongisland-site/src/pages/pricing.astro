---
import SiteLayout from '../design/layouts/SiteLayout.astro';
import PageHead from '../design/components/PageHead.astro';
import PriceGroup from '../design/components/PriceGroup.astro';
import PriceSheet from '../design/components/PriceSheet.astro';
import BundleBar from '../design/components/BundleBar.astro';
import CardPrice from '../design/components/CardPrice.astro';
import FAQ from '../design/components/FAQ.astro';
import ContactSection from '../design/components/ContactSection.astro';
import { cardLine, money, prices, websitePlans, carePlans, seoPlans, googleAdsPlan, socialAdsPlan } from '../design/pricing';
import { faq } from '../design/content';

const chips = [
  ['Websites', '#websites'],
  ['Care plans', '#care'],
  ['SEO', '#seo'],
  ['Google Ads', '#google-ads'],
  ['Social ads', '#social-ads'],
];
---

<SiteLayout
  title="Pricing | Optimize Long Island"
  description={`Every price, up front. Websites from ${money(prices.launch)}, care plans from ${money(prices.care)} a month, SEO from ${money(prices.seoLocal)} a month, and ads management.`}
>
  <PageHead
    crumbs={[{ name: 'Pricing', url: '/pricing/' }]}
    eyebrow="Pricing"
    title="Every price, up front."
    lede="Fixed prices for websites. Monthly prices for care, SEO and ads. Every plan starts with a free analysis."
  >
    <ul class="chips">
      {chips.map(([l, h]) => <li><a href={h}>{l}</a></li>)}
    </ul>
  </PageHead>

  <section class="section pay" id="how-to-pay">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Payment</p>
          <h2>How you can pay.</h2>
        </div>
      </div>
      <ul class="paylist">
        <li>Websites and other one-time payments: check, cash, bank transfer or card.</li>
        <li>Monthly plans are paid automatically, by bank transfer or card. A year paid in advance can also be paid by check or cash.</li>
        <li>The listed prices are for check, cash or bank transfer.</li>
        <li>Credit cards add a 3% card fee. The credit card price is shown with every price on this page, in dollars and cents.</li>
        <li>Debit cards pay the listed price.</li>
        <li>Billing is handled through Square.</li>
      </ul>
    </div>
  </section>

  <PriceGroup id="websites" eyebrow="Websites" heading="Fixed-price websites.">
    {websitePlans.map((p) => <PriceSheet plan={p} />)}
    <div slot="notes" class="notes">
      <div>
        <p><strong>Extra pages:</strong> {money(prices.extraPage)} each. <CardPrice text={`${cardLine(prices.extraPage)} for an extra page`} /></p>
        <p><strong>What you provide for Launch:</strong> answers to a short questionnaire, your logo and your photos.</p>
      </div>
      <div>
        <p><strong>Not included in Launch:</strong> copywriting from scratch, logo design, photography, e-commerce.</p>
      </div>
    </div>
  </PriceGroup>

  <PriceGroup id="care" tone="paper" cols={2} narrow eyebrow="Care plans" heading="Hosting and care, by the month." intro="A care plan is required to host with us.">
    {carePlans.map((p) => <PriceSheet plan={p} />)}
    <p slot="notes" class="after">Pay yearly and get two months free: {money(prices.careYearly)} a year for Care.<CardPrice text={cardLine(prices.careYearly)} /></p>
  </PriceGroup>

  <PriceGroup id="seo" eyebrow="SEO" heading="Monthly SEO plans.">
    {seoPlans.map((p) => <PriceSheet plan={p} />)}
  </PriceGroup>

  <PriceGroup id="ads" tone="paper" cols={2} eyebrow="Ads management" heading="Google Ads and social ads.">
    <PriceSheet plan={googleAdsPlan} />
    <PriceSheet plan={socialAdsPlan} />
    <Fragment slot="notes"><BundleBar /></Fragment>
  </PriceGroup>

  <FAQ heading="Pricing questions." items={[faq.pay, faq.cost, faq.care, faq.changes, faq.adspend, faq.wordpress]} pricingLink={false} />

  <ContactSection />
</SiteLayout>

<style>
  .chips { list-style: none; display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 36px; }
  .chips a { display: inline-flex; align-items: center; min-height: 44px; font-family: var(--font-mono); font-weight: 500; font-size: 13px; color: var(--on-deep); border: 1px solid rgba(255, 255, 255, 0.45); border-radius: var(--radius-pill); padding: 8px 14px; }
  .chips a:hover { border-color: var(--accent); }
  .notes { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; border-top: 1px solid var(--line); padding-top: 32px; font-size: 15px; color: var(--muted); }
  .notes p + p { margin-top: 10px; }
  .notes strong { color: var(--ink); font-weight: 600; }
  .paylist { list-style: none; display: grid; gap: 10px; max-width: 70ch; font-size: 17px; }
  .paylist li { padding-left: 18px; position: relative; }
  .paylist li::before { content: ''; position: absolute; left: 0; top: 0.7em; width: 7px; height: 7px; background: var(--accent); border-radius: 1px; }
  .pay { padding-bottom: 0; }
  .after { text-align: center; font-size: 17px; }
  @media (max-width: 900px) { .notes { grid-template-columns: 1fr; gap: 12px; } }
</style>
