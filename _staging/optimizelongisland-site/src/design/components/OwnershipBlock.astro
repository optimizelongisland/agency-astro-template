---
import CheckStamp from './CheckStamp.astro';
interface Props { size?: 'large' | 'regular'; tone?: 'bg' | 'paper' }
const { size = 'large', tone = 'bg' } = Astro.props;
---

<section class:list={['section', { 'section--paper': tone === 'paper' }, size]} id="ownership">
  <div class="wrap">
    <div class="statement">
      <h2>Your site. Your content. Your domain.</h2>
      <p class="sub">If you leave, you take everything with you.</p>
    </div>
    <ul class="items">
      {
        ['The site', 'The content', 'The domain'].map((l) => (
          <li>
            <span class="label mono">{l}</span>
            <span class="yours">Yours <CheckStamp size={20} /></span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .statement { max-width: 900px; margin-bottom: 64px; }
  .large h2 { font-size: clamp(34px, 5vw, 56px); }
  .sub { font-size: clamp(18px, 2vw, 20px); color: var(--muted); margin-top: 20px; }
  .items { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  li { border-top: 1px solid var(--line); padding-top: 24px; display: flex; flex-direction: column; gap: 10px; }
  .label { font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .yours { display: flex; align-items: center; gap: 10px; font-size: 22px; font-weight: 600; }
  @media (max-width: 640px) {
    .items { grid-template-columns: 1fr; gap: 0; }
    li { flex-direction: row; justify-content: space-between; align-items: center; padding: 18px 0; }
    .statement { margin-bottom: 32px; }
  }
</style>
