---
// Related posts and pages: a ruled list of title, optional one-line text and
// an arrow. Standalone section; place it before the lead form.
interface Props {
  items: { href: string; title: string; text?: string }[];
  heading?: string;
  eyebrow?: string;
  tone?: 'bg' | 'paper';
}
const { items, heading = 'Related reading', eyebrow = 'Keep reading', tone = 'bg' } = Astro.props;
---

<section class:list={['rel', { 'section--paper': tone === 'paper' }]}>
  <div class="wrap cols">
    <header>
      <p class="eyebrow">{eyebrow}</p>
      <h2>{heading}</h2>
    </header>
    <ul>
      {
        items.map((i) => (
          <li>
            <a href={i.href}>
              <span class="t">{i.title}</span>
              {i.text && <span class="d">{i.text}</span>}
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .rel { padding: 72px 0; }
  .cols { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 24px 64px; align-items: start; }
  h2 { font-size: clamp(26px, 3vw, 32px); line-height: 1.15; letter-spacing: -0.015em; }
  ul { list-style: none; border-top: 1px solid var(--line); }
  li { border-bottom: 1px solid var(--line); }
  a { position: relative; display: block; padding: 18px 44px 18px 0; min-height: 56px; }
  .t { display: block; font-weight: 600; font-size: 18px; line-height: 1.35; color: var(--accent-2); }
  .d { display: block; color: var(--muted); font-size: 16px; margin-top: 4px; max-width: 58ch; }
  .arrow { position: absolute; right: 4px; top: 18px; font-size: 20px; color: var(--accent-2); }
  a:hover .t { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 900px) { .cols { grid-template-columns: minmax(0, 1fr); } .rel { padding: 48px 0; } }
</style>
