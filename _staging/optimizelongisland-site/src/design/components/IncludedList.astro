---
import CheckStamp from './CheckStamp.astro';
interface Props { eyebrow?: string; heading: string; items: string[]; tone?: 'bg' | 'paper' }
const { eyebrow = 'What is included', heading, items, tone = 'paper' } = Astro.props;
---

<section class:list={['section', { 'section--paper': tone === 'paper' }]}>
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h2>{heading}</h2>
      </div>
    </div>
    <ul class="list">
      {items.map((i) => <li><CheckStamp size={20} /><span>{i}</span></li>)}
    </ul>
  </div>
</section>

<style>
  .list { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 64px; }
  li { display: flex; align-items: flex-start; gap: 16px; border-top: 1px solid var(--line); padding: 22px 0; font-size: 18px; line-height: 1.45; }
  li :global(svg) { margin-top: 3px; }
  @media (max-width: 900px) { .list { grid-template-columns: 1fr; } li { font-size: 17px; } }
</style>
