---
import BuildSheet from './BuildSheet.astro';
interface Props { expanded?: boolean }
const { expanded = false } = Astro.props;
---

<section class="section section--deep" id="technology">
  <div class="wrap cols">
    <div>
      <p class="eyebrow">How it is built</p>
      <h2>No WordPress. No plugins. Nothing to break.</h2>
      <div class="copy">
        {
          expanded ? (
            <>
              <p><strong>Fast.</strong> Astro ships fast, lightweight pages. Pages that load quickly are easier for visitors to use and for Google to read.</p>
              <p><strong>Secure.</strong> There are no plugins to break or get hacked, and no page builder bloat. Hosting is on Vercel's global network.</p>
              <p><strong>Reversible.</strong> Every change is stored and versioned on GitHub, so it is saved and can be rolled back.</p>
              <p><strong>Checked.</strong> Claude, an AI model made by Anthropic, does the heavy lifting. A person directs the work and reviews every page before launch.</p>
            </>
          ) : (
            <>
              <p><strong>Fast.</strong> Astro ships lightweight pages.</p>
              <p><strong>Secure.</strong> No plugins to break or get hacked.</p>
              <p><strong>Reversible.</strong> Every change is saved on GitHub and can be rolled back.</p>
            </>
          )
        }
      </div>
    </div>
    <div>
      <BuildSheet
        tone="dark"
        title="Stack sheet"
        rows={[
          { label: 'Design and build', value: 'Claude, an AI model made by Anthropic' },
          { label: 'Framework', value: 'Astro' },
          { label: 'Code', value: 'stored and versioned on GitHub' },
          { label: 'Hosting', value: 'Vercel global network' },
          { label: 'WordPress', value: 'none' },
          { label: 'Plugins', value: 'none' },
          { label: 'Page builder', value: 'none' },
        ]}
        checkLabel="Checked by a person before launch"
      />
      <p class="note">Optimize Long Island is not affiliated with or endorsed by these companies.</p>
    </div>
  </div>
</section>

<style>
  .cols { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 80px; align-items: start; }
  h2 { margin-bottom: 32px; }
  .copy p { color: var(--on-deep-muted); margin-bottom: 18px; max-width: 46ch; }
  .copy strong { color: var(--on-deep); font-weight: 600; }
  .note { margin-top: 16px; font-size: 13px; color: var(--on-deep-muted); }
  @media (max-width: 900px) { .cols { grid-template-columns: 1fr; gap: 40px; } }
</style>
