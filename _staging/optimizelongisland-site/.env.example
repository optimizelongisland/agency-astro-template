# Copy to .env and fill in per client. Never commit the real .env file.

# Google Analytics 4 - Admin > Data Streams > your stream > Measurement ID
PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console - Settings > Ownership verification > HTML tag method,
# copy just the content="..." value, not the whole tag
PUBLIC_GSC_VERIFICATION=

# ---- CONTACT FORM (src/components/ContactForm.astro -> src/pages/api/contact.ts) ----
# In production set these in Vercel > Project > Settings > Environment Variables,
# not in a committed file. With none of them set, `npm run dev` prints each test
# lead in the terminal instead of sending it.

# Resend (resend.com) API key - sends the lead notification email
RESEND_API_KEY=

# The "from" address. Its domain must be verified in Resend.
# Example: Website Leads <leads@send.youragency.com>
LEAD_FROM_EMAIL=

# Where the client receives leads. Comma-separate for more than one inbox.
LEAD_TO_EMAIL=

# Optional. Every lead is also POSTed as JSON to each URL here (comma-separated).
# Use for a Go High Level inbound webhook (CRM upsell) and/or a backup log such
# as a Google Sheet. If email fails, these still receive the lead.
LEAD_WEBHOOK_URLS=

# Optional but recommended: Cloudflare Turnstile spam check (free).
# Create a widget at dash.cloudflare.com > Turnstile, then set both keys.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
