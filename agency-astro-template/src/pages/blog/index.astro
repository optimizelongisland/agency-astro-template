---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout
  title="Blog | Client Business Name"
  description="Tips, guides, and updates from Client Business Name."
>
  <section class="section wrap">
    <div class="section-head">
      <h1>Blog</h1>
      <p>Guides and updates worth knowing before your next project.</p>
    </div>

    <div class="post-grid">
      {
        posts.map((post) => (
          <a href={`/blog/${post.id}/`} class="post-card">
            <div class="card-image">
              <Image src={post.data.coverImage} alt={post.data.coverImageAlt} width={400} height={240} />
            </div>
            <p class="card-date">
              {post.data.publishDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </p>
            <h2>{post.data.title}</h2>
            <p class="card-desc">{post.data.metaDescription}</p>
          </a>
        ))
      }
    </div>

    {posts.length === 0 && <p class="empty">No posts published yet.</p>}
  </section>
</BaseLayout>

<style>
  h1 {
    font-size: clamp(32px, 4.5vw, 46px);
  }
  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .post-card {
    display: block;
  }
  .card-image {
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: 16px;
  }
  .card-image :global(img) {
    width: 100%;
    height: auto;
    transition: transform 0.3s ease;
  }
  .post-card:hover .card-image :global(img) {
    transform: scale(1.03);
  }
  .card-date {
    font-size: 13px;
    color: var(--accent-2);
    margin-bottom: 8px;
  }
  .post-card h2 {
    font-size: 19px;
    margin-bottom: 8px;
  }
  .card-desc {
    font-size: 14.5px;
    color: #4b5750;
  }
  .empty {
    color: #4b5750;
  }
  @media (max-width: 900px) {
    .post-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .post-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
