---
// Embeds a Go High Level form/chat widget so leads land directly in the
// client's GHL CRM instead of a plain mailto link.
//
// How to get the values below:
// 1. In GHL: Sites -> Forms -> build the form -> "Add Form" -> Embed Code
// 2. GHL gives you a snippet like:
//      <iframe src="https://api.leadconnectorhq.com/widget/form/FORM_ID" ...></iframe>
//      <script src="https://link.msgsndr.com/js/form_embed.js"></script>
// 3. Pull FORM_ID out of the src URL and pass it as `formId` below.
//
// If a client doesn't use GHL forms, leave this component out and the CTA's
// mailto/tel links still work fine on their own.

interface Props {
  formId: string;
  height?: string;
}
const { formId, height = '600px' } = Astro.props;
---

<div class="ghl-form-wrap">
  <iframe
    src={`https://api.leadconnectorhq.com/widget/form/${formId}`}
    style={`width: 100%; height: ${height}; border: none; border-radius: var(--radius);`}
    title="Contact form"
  ></iframe>
</div>

<script src="https://link.msgsndr.com/js/form_embed.js" is:inline></script>

<style>
  .ghl-form-wrap {
    max-width: 560px;
    margin: 0 auto;
  }
</style>
