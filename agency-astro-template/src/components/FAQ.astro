---
// FAQ section with FAQPage structured data. This is the single highest-leverage
// component for AEO/GEO: AI answer engines (AI Overviews, ChatGPT, Perplexity)
// pull direct question/answer pairs almost verbatim when the schema is present
// and the answer text itself is a clean, self-contained sentence or two.
//
// Writing guidance for the `answer` field:
// - Lead with the direct answer in the first sentence. Don't bury it.
// - Keep each answer under ~50 words. Long answers get truncated or skipped.
// - Write it exactly as you'd want it read aloud by a voice assistant.

interface FAQItem {
  question: string;
  answer: string;
}
interface Props {
  heading?: string;
  items: FAQItem[];
}
const { heading = 'Frequently asked questions', items } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<section class="faq section" id="faq">
  <div class="wrap">
    <h2>{heading}</h2>
    <div class="faq-list">
      {
        items.map((item, i) => (
          <details class="faq-item" name="faq">
            <summary>
              <span>{item.question}</span>
              <span class="chevron" aria-hidden="true">+</span>
            </summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<style>
  .faq h2 {
    font-size: clamp(28px, 3.4vw, 38px);
    margin-bottom: 32px;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
    max-width: 760px;
  }
  .faq-item {
    border-bottom: 1px solid var(--line);
    padding: 20px 0;
  }
  .faq-item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    cursor: pointer;
    font-weight: 600;
    font-size: 16px;
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .chevron {
    font-family: var(--font-display);
    font-size: 22px;
    color: var(--accent-2);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }
  .faq-item[open] .chevron {
    transform: rotate(45deg);
  }
  .faq-item p {
    margin-top: 12px;
    color: #4b5750;
    font-size: 15px;
    max-width: 65ch;
  }
</style>
