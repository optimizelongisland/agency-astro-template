---
interface Props {
  quote: string;
  attribution: string;
}
const { quote, attribution } = Astro.props;
---

<section class="testimonial">
  <div class="wrap">
    <blockquote>
      {quote}
      <cite>— {attribution}</cite>
    </blockquote>
  </div>
</section>

<style>
  .testimonial {
    background: var(--accent-2);
    color: var(--paper);
    padding: 80px 0;
  }
  blockquote {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.4;
    max-width: 22ch;
  }
  cite {
    display: block;
    margin-top: 24px;
    font-style: normal;
    font-size: 14px;
    opacity: 0.85;
  }
</style>
